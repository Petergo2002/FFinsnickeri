---
import { siteConfig, knallenServices } from "../data/site";
import Schema from "../components/Schema.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string | URL;
  schema?: any;
}

const {
  title = `${siteConfig.businessName} | ${siteConfig.tagline}`,
  description = siteConfig.defaultDescription,
  image = "/service-hero-fasad.webp",
  canonicalURL = new URL(Astro.url.pathname, Astro.site),
  schema
} = Astro.props;

const pathname = Astro.url.pathname;
const phoneHref = `tel:${siteConfig.primaryPhone.replace(/\s+/g, "")}`;

---

<!doctype html>
<html lang="sv" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.site)} />

    <Schema item={schema} />

    <title>{title}</title>
    <link rel="icon" type="image/webp" href="/logo.webp" />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&family=Inter:wght@400;500;600&family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-surface text-on-surface font-body selection:bg-primary-container selection:text-on-primary-container flex min-h-screen flex-col antialiased">
    
    <!-- Top Navigation -->
    <nav class="fixed top-0 w-full z-50 border-b border-surface-container-high bg-white/80 backdrop-blur-md shadow-sm">
      <div class="flex h-18 items-center justify-between max-w-7xl mx-auto px-4 sm:px-6 sm:h-20">
        <a href="/" class="flex flex-shrink-0 items-center">
          <img src="/logo.webp" alt={siteConfig.businessName + " logotyp"} class="h-10 md:h-12 w-auto" />
        </a>
        
        <div class="hidden md:flex items-center gap-8 font-headline text-lg font-semibold tracking-tight">
          <a class={`transition-colors ${pathname === "/" ? "text-secondary border-b-2 border-secondary pb-1" : "text-secondary-dim hover:text-secondary border-b-2 border-transparent pb-1"}`} href="/">Hem</a>
          
          <!-- Tjänster dropdown integrated -->
          <div class="group relative">
            <button
              type="button"
              class={`flex items-center gap-1 transition-colors ${pathname.startsWith("/tjanster") ? "text-secondary border-b-2 border-secondary pb-1" : "text-secondary-dim hover:text-secondary pb-1 border-b-2 border-transparent"}`}
            >
              Tjänster
              <span class="material-symbols-outlined text-lg transition-transform duration-200 group-hover:rotate-180">expand_more</span>
            </button>
            <div class="invisible absolute left-1/2 top-full z-50 mt-2 w-72 -translate-x-1/2 rounded-2xl border border-surface-container-high bg-surface-container-lowest p-4 opacity-0 shadow-2xl transition-all duration-200 group-hover:visible group-hover:opacity-100">
              <a
                href="/tjanster"
                class="mb-3 flex items-center gap-2 rounded-xl bg-secondary-container px-4 py-2.5 text-sm font-bold text-on-secondary-container hover:bg-secondary-fixed transition-colors"
              >
                <span class="material-symbols-outlined text-base">format_list_bulleted</span>
                Alla tjänster
              </a>
              <p class="mb-2 px-1 text-xs font-semibold uppercase tracking-widest text-outline">Direktlänkar</p>
              <div class="grid grid-cols-2 gap-1">
                {knallenServices.map((svc) => (
                  <a
                    href={`/tjanster/${svc.slug}`}
                    class={`rounded-lg px-3 py-2 text-xs font-semibold transition-colors hover:bg-secondary-container hover:text-on-secondary-container ${
                      pathname === `/tjanster/${svc.slug}` ? "bg-secondary-container text-on-secondary-container" : "text-on-surface-variant"
                    }`}
                  >
                    {svc.name}
                  </a>
                ))}
              </div>
            </div>
          </div>

          <a class={`transition-colors ${pathname === "/om-oss" ? "text-secondary border-b-2 border-secondary pb-1" : "text-secondary-dim hover:text-secondary border-b-2 border-transparent pb-1"}`} href="/om-oss">Om oss</a>
          <a class={`transition-colors ${pathname === "/projekt" ? "text-secondary border-b-2 border-secondary pb-1" : "text-secondary-dim hover:text-secondary border-b-2 border-transparent pb-1"}`} href="/projekt">Referenser</a>
        </div>
        
        <div class="hidden md:flex items-center">
          <a href="/kontakt" class="bg-secondary text-on-secondary px-6 py-2.5 rounded-lg font-semibold scale-95 active:scale-90 duration-200 transition-all hover:bg-secondary-dim shadow-sm">
            Kontakta oss
          </a>
        </div>

        <!-- Mobile navigation toggle -->
        <button id="mobile-menu-btn" class="md:hidden p-2 text-primary focus:outline-none transition-transform active:scale-90" aria-label="Öppna meny">
          <span class="material-symbols-outlined text-4xl">menu</span>
        </button>
      </div>

    </nav>
    
    <!-- Full-screen Mobile Menu Overlay (Moved outside nav for better z-index) -->
    <div id="mobile-menu" class="fixed inset-0 z-[110] flex min-h-[100dvh] flex-col overflow-y-auto overscroll-contain bg-surface pb-[env(safe-area-inset-bottom)] transform transition-all duration-500 ease-in-out translate-x-full opacity-0 invisible md:hidden">
      <!-- Menu Header -->
      <div class="flex items-center justify-between h-18 px-4 border-b border-surface-container-high bg-surface/80 backdrop-blur-md">
        <a href="/" class="flex flex-shrink-0 items-center">
          <img src="/logo.webp" alt={siteConfig.businessName + " logotyp"} class="h-10 w-auto" />
        </a>
        <button id="mobile-menu-close" class="p-2 text-primary hover:text-secondary focus:outline-none transition-all active:scale-90" aria-label="Stäng meny">
          <span class="material-symbols-outlined text-4xl">close</span>
        </button>
      </div>

      <!-- Menu Navigation -->
      <nav class="flex-grow overflow-y-auto px-5 py-6 sm:px-6 sm:py-8">
        <div class="mx-auto flex w-full max-w-md flex-col gap-3">
          <a
            href="/"
            class={`mobile-nav-link animate-menu-item rounded-2xl border px-4 py-4 text-2xl font-headline font-bold transition-colors ${
              pathname === "/"
                ? "border-secondary bg-secondary-container text-on-secondary-container"
                : "border-surface-container-high bg-white text-on-surface hover:text-secondary"
            }`}
            style="animation-delay: 100ms;"
          >
            Hem
          </a>

          <a
            href="/tjanster"
            class={`mobile-nav-link animate-menu-item rounded-2xl border px-4 py-4 text-2xl font-headline font-bold transition-colors ${
              pathname === "/tjanster"
                ? "border-secondary bg-secondary-container text-on-secondary-container"
                : "border-surface-container-high bg-white text-on-surface hover:text-secondary"
            }`}
            style="animation-delay: 180ms;"
          >
            Våra tjänster
          </a>

          <details class="animate-menu-item overflow-hidden rounded-2xl border border-surface-container-high bg-white" style="animation-delay: 260ms;">
            <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-4 text-xl font-headline font-bold text-on-surface marker:hidden">
              Alla tjänster
              <span class="material-symbols-outlined text-2xl text-secondary transition-transform details-arrow">expand_more</span>
            </summary>
            <div class="border-t border-surface-container-high px-3 py-3">
              <div class="grid grid-cols-1 gap-2">
                {knallenServices.map((svc) => (
                  <a
                    href={`/tjanster/${svc.slug}`}
                    class={`mobile-nav-link rounded-xl px-3 py-2 text-base font-semibold transition-colors ${
                      pathname === `/tjanster/${svc.slug}`
                        ? "bg-secondary-container text-on-secondary-container"
                        : "text-on-surface-variant hover:bg-surface-container hover:text-secondary"
                    }`}
                  >
                    {svc.name}
                  </a>
                ))}
              </div>
            </div>
          </details>

          <a
            href="/om-oss"
            class={`mobile-nav-link animate-menu-item rounded-2xl border px-4 py-4 text-2xl font-headline font-bold transition-colors ${
              pathname === "/om-oss"
                ? "border-secondary bg-secondary-container text-on-secondary-container"
                : "border-surface-container-high bg-white text-on-surface hover:text-secondary"
            }`}
            style="animation-delay: 340ms;"
          >
            Om oss
          </a>

          <a
            href="/projekt"
            class={`mobile-nav-link animate-menu-item rounded-2xl border px-4 py-4 text-2xl font-headline font-bold transition-colors ${
              pathname === "/projekt"
                ? "border-secondary bg-secondary-container text-on-secondary-container"
                : "border-surface-container-high bg-white text-on-surface hover:text-secondary"
            }`}
            style="animation-delay: 420ms;"
          >
            Referenser
          </a>

          <a
            href="/kontakt"
            class={`mobile-nav-link animate-menu-item rounded-2xl border px-4 py-4 text-2xl font-headline font-bold transition-colors ${
              pathname === "/kontakt"
                ? "border-secondary bg-secondary-container text-on-secondary-container"
                : "border-surface-container-high bg-white text-on-surface hover:text-secondary"
            }`}
            style="animation-delay: 500ms;"
          >
            Kontakta oss
          </a>
        </div>
      </nav>

      <!-- Mobile Menu Footer -->
      <div class="border-t border-surface-container-high bg-surface-dim p-6 pb-[calc(1.5rem+env(safe-area-inset-bottom))] sm:p-8 animate-menu-item" style="animation-delay: 600ms;">
        <div class="flex flex-col gap-6 text-center max-w-xs mx-auto">
          <div class="space-y-2">
            <p class="text-[10px] font-bold uppercase tracking-widest text-outline">Direktkontakt</p>
            <a href={phoneHref} class="flex items-center justify-center gap-2 text-xl font-bold text-on-surface hover:text-secondary transition-colors">
              <span class="material-symbols-outlined text-secondary">call</span>
              {siteConfig.primaryPhone}
            </a>
            <a href={`mailto:${siteConfig.primaryEmail}`} class="text-sm font-medium text-on-surface-variant hover:text-secondary transition-colors decoration-secondary/30 underline underline-offset-4">
              {siteConfig.primaryEmail}
            </a>
          </div>
          
          <div class="flex justify-center gap-4">
            <a href="#" class="w-11 h-11 rounded-xl bg-white border border-surface-container-high flex items-center justify-center text-primary shadow-sm hover:bg-secondary hover:text-white hover:border-secondary transition-all">
              <span class="material-symbols-outlined">camera_indoor</span>
            </a>
            <a href="#" class="w-11 h-11 rounded-xl bg-white border border-surface-container-high flex items-center justify-center text-primary shadow-sm hover:bg-secondary hover:text-white hover:border-secondary transition-all">
              <span class="material-symbols-outlined">alternate_email</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <script is:inline>
      function initMobileMenu() {
        const menuBtn = document.getElementById('mobile-menu-btn');
        const closeBtn = document.getElementById('mobile-menu-close');
        const mobileMenu = document.getElementById('mobile-menu');
        const body = document.body;
        const navLinks = document.querySelectorAll('.mobile-nav-link');

        function toggleMenu(show) {
          if (show) {
            mobileMenu.classList.remove('translate-x-full', 'opacity-0', 'invisible');
            mobileMenu.classList.add('translate-x-0', 'opacity-100', 'visible');
            body.classList.add('no-scroll');
          } else {
            mobileMenu.classList.add('opacity-0');
            mobileMenu.classList.remove('opacity-100');
            // Animate out slightly before hiding
            setTimeout(() => {
              mobileMenu.classList.add('translate-x-full');
            }, 100);
            
            body.classList.remove('no-scroll');
            // Delay visibility to allow transition
            setTimeout(() => {
              if (mobileMenu.classList.contains('opacity-0')) {
                mobileMenu.classList.add('invisible');
              }
            }, 500);
          }
        }

        if (menuBtn) {
          // Clone to remove old listeners if re-init
          const newMenuBtn = menuBtn.cloneNode(true);
          menuBtn.parentNode.replaceChild(newMenuBtn, menuBtn);
          newMenuBtn.addEventListener('click', () => toggleMenu(true));
        }
        
        if (closeBtn) {
          const newCloseBtn = closeBtn.cloneNode(true);
          closeBtn.parentNode.replaceChild(newCloseBtn, closeBtn);
          newCloseBtn.addEventListener('click', () => toggleMenu(false));
        }
        
        navLinks.forEach(link => {
          link.addEventListener('click', () => toggleMenu(false));
        });
      }

      initMobileMenu();
      document.addEventListener('astro:after-swap', initMobileMenu);
    </script>

    <main class="flex-grow pt-18 sm:pt-20">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="w-full pt-24 pb-12 border-t border-surface-container-high bg-surface font-body text-sm leading-relaxed mt-24">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-12 max-w-7xl mx-auto px-4 sm:px-6 mb-20">
        <div class="space-y-6">
          <a href="/" class="block">
            <img src="/logo.webp" alt={siteConfig.businessName + " logotyp"} class="h-10 md:h-12 w-auto" />
          </a>
          <p class="text-secondary-dim max-w-xs">{siteConfig.tagline}. Din helhetspartner i {siteConfig.serviceAreaLabel.toLowerCase()}.</p>
          <div class="flex gap-4">
            <a class="w-10 h-10 rounded-full border border-outline-variant/20 flex items-center justify-center text-secondary-dim hover:bg-secondary hover:text-on-secondary transition-all" href="#">
              <span class="material-symbols-outlined text-xl">social_leaderboard</span>
            </a>
            <a class="w-10 h-10 rounded-full border border-outline-variant/20 flex items-center justify-center text-secondary-dim hover:bg-secondary hover:text-on-secondary transition-all" href="#">
              <span class="material-symbols-outlined text-xl">camera</span>
            </a>
          </div>
        </div>
        <div class="space-y-6">
          <h4 class="font-bold text-primary uppercase tracking-widest text-xs">Tjänster</h4>
          <ul class="space-y-4">
            {knallenServices.slice(0, 4).map((svc) => (
              <li><a class="text-secondary-dim hover:text-secondary underline decoration-2 underline-offset-4 transition-colors" href={`/tjanster/${svc.slug}`}>{svc.name}</a></li>
            ))}
          </ul>
        </div>
        <div class="space-y-6">
          <h4 class="font-bold text-primary uppercase tracking-widest text-xs">Företaget</h4>
          <ul class="space-y-4">
            <li><a class="text-secondary-dim hover:text-secondary underline decoration-2 underline-offset-4 transition-colors" href="/om-oss">Om oss</a></li>
            <li><a class="text-secondary-dim hover:text-secondary underline decoration-2 underline-offset-4 transition-colors" href="/projekt">Referenser</a></li>
            <li><a class="text-secondary-dim hover:text-secondary underline decoration-2 underline-offset-4 transition-colors" href="/kontakt">Kontakta oss</a></li>
          </ul>
        </div>
        <div class="space-y-6">
          <h4 class="font-bold text-primary uppercase tracking-widest text-xs">Kontakt</h4>
          <ul class="space-y-4 text-secondary-dim">
            <li class="flex items-start gap-3">
              <span class="material-symbols-outlined text-secondary text-lg">mail</span>
              <a href={`mailto:${siteConfig.primaryEmail}`} class="break-all hover:text-secondary">{siteConfig.primaryEmail}</a>
            </li>
            <li class="flex items-start gap-3">
              <span class="material-symbols-outlined text-secondary text-lg">phone</span>
              <a href={phoneHref} class="hover:text-secondary">{siteConfig.primaryPhone}</a>
            </li>
            <li class="flex items-start gap-3">
              <span class="material-symbols-outlined text-secondary text-lg">pin_drop</span>
              <span>{siteConfig.address}</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="material-symbols-outlined text-secondary text-lg">schedule</span>
              {siteConfig.hours}
            </li>
          </ul>
        </div>
      </div>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 pt-12 border-t border-surface-container-high/50 flex flex-col md:flex-row justify-between items-center gap-6">
        <span class="text-secondary-dim">© {new Date().getFullYear()} {siteConfig.businessName}. Alla rättigheter förbehållna.</span>
        <div class="flex gap-8 text-outline-variant">
          <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">security</span>
          <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">eco</span>
        </div>
      </div>
    </footer>
  </body>
</html>
