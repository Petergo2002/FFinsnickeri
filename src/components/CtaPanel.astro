---
interface Props {
  eyebrow?: string;
  title: string;
  body: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const { eyebrow, title, body, primaryHref, primaryLabel, secondaryHref, secondaryLabel } = Astro.props;
---

<section class="max-w-7xl mx-auto w-full px-4 sm:px-6 mb-24 md:mb-32">
  <div class="relative isolate overflow-hidden rounded-[2rem] bg-primary px-6 py-14 text-center shadow-2xl sm:rounded-[2.5rem] sm:px-8 sm:py-16 md:p-24">
    <!-- Premium Gradient Orbs -->
    <div class="absolute top-0 right-0 w-96 h-96 bg-secondary/10 rounded-full -translate-y-1/2 translate-x-1/2 blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-white/5 rounded-full translate-y-1/2 -translate-x-1/2 blur-3xl pointer-events-none"></div>
    
    <div class="relative z-10 max-w-3xl mx-auto">
      {eyebrow && (
        <span class="text-secondary font-bold tracking-[0.2em] text-xs uppercase mb-6 block drop-shadow-sm">
          {eyebrow}
        </span>
      )}
      
      <h2 class="font-headline mb-8 text-3xl font-extrabold leading-tight tracking-tight text-white sm:text-4xl md:text-6xl">
        {title}
      </h2>
      
      <p class="mx-auto mb-10 max-w-2xl text-base leading-relaxed text-on-primary/80 sm:text-lg md:mb-12 md:text-xl">
        {body}
      </p>
      
      <div class="flex flex-col sm:flex-row gap-6 justify-center">
        {primaryHref && primaryLabel && (
          <a 
            href={primaryHref} 
            class="rounded-2xl bg-secondary px-6 py-4 text-center text-base font-bold text-on-secondary transition-all duration-200 scale-100 active:scale-95 hover:bg-secondary-dim shadow-xl sm:px-10 sm:py-5 sm:text-xl"
          >
            {primaryLabel}
          </a>
        )}
        {secondaryHref && secondaryLabel && (
          <a 
            href={secondaryHref} 
            class="rounded-2xl border-2 border-white/30 px-6 py-4 text-center text-base font-bold text-white transition-all duration-200 scale-100 active:scale-95 hover:bg-white/10 backdrop-blur-sm sm:px-10 sm:py-5 sm:text-xl"
          >
            {secondaryLabel}
          </a>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .font-headline {
    font-family: 'Manrope', sans-serif;
    letter-spacing: -0.02em;
  }
</style>
