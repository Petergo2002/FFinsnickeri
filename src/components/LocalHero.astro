---
import { siteConfig } from "../data/site";

interface Props {
  eyebrow?: string;
  title: string;
  body: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  meta?: { label: string; value: string }[];
}

const {
  eyebrow,
  title,
  body,
  primaryHref = "/kontakt",
  primaryLabel = "Få ett kostnadsförslag",
  secondaryHref = "/tjanster",
  secondaryLabel = "Se över våra tjänster",
  meta = []
} = Astro.props;

const trustHighlights = [
  "Tiotals års erfarenhet",
  "Lösningar för olika budgetar",
  "Kvalitet, estetik och kundvärde"
];
---

<section class="relative isolate overflow-hidden bg-slate-950 pb-32 pt-24 text-white sm:pb-40 sm:pt-32">
  <div class="absolute inset-0 -z-10">
    <img
      src="https://images.unsplash.com/photo-1621905252507-b35492cc74b4?q=80&w=2069&auto=format&fit=crop&fm=webp"
      alt="Snickeriprojekt i arbete för kunder i Borås och Svenljunga"
      class="h-full w-full object-cover object-right opacity-30 mix-blend-screen"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/90 to-slate-950/50"></div>
  </div>

  <div class="relative z-10 mx-auto flex max-w-7xl flex-col items-center justify-between gap-12 px-6 lg:flex-row lg:px-8">
    <div class="max-w-2xl lg:max-w-xl">
      {eyebrow && (
        <p class="mb-6 inline-flex items-center rounded-full bg-[#CD061F]/10 px-3 py-1 text-sm font-semibold text-[#f2a5b0] ring-1 ring-inset ring-[#CD061F]/20">
          <span class="mr-2 h-2 w-2 rounded-full bg-secondary"></span>
          {eyebrow}
        </p>
      )}
      <h1 class="mb-6 text-4xl font-bold tracking-tight text-white sm:text-6xl leading-tight">
        {title}
      </h1>
      <p class="mb-8 max-w-xl text-lg leading-8 text-slate-300">
        {body}
      </p>

      <div class="flex flex-col gap-4 sm:flex-row">
        {primaryHref && (
          <a href={primaryHref} class="rounded-full bg-secondary px-8 py-4 text-center text-sm font-bold text-white shadow-sm transition-all hover:bg-[#b1051a] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#CD061F]">
            {primaryLabel}
          </a>
        )}
        {secondaryHref && (
          <a href={secondaryHref} class="rounded-full bg-white/10 px-8 py-4 text-center text-sm font-bold text-white ring-1 ring-inset ring-white/20 transition-all hover:bg-white/20">
            {secondaryLabel}
          </a>
        )}
      </div>

      <div class="mt-12 flex flex-wrap gap-3">
        {meta.map((item) => (
          <div class="rounded-2xl border border-white/10 bg-white/5 px-5 py-4 backdrop-blur">
            <div class="text-2xl font-extrabold text-white">{item.value}</div>
            <div class="text-xs font-bold uppercase tracking-wider text-slate-300">{item.label}</div>
          </div>
        ))}
      </div>
    </div>

    <div class="w-full max-w-sm">
      <div class="rounded-[2rem] border border-white/10 bg-white/5 p-8 shadow-2xl backdrop-blur-xl">
        <div class="mb-6 flex items-center justify-between gap-3">
          <span class="rounded-full border border-[#CD061F]/20 bg-[#CD061F]/10 px-3 py-1 text-xs font-bold uppercase tracking-wider text-[#f2a5b0]">
            {siteConfig.experience}
          </span>
          <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-bold uppercase tracking-wider text-slate-200">
            {siteConfig.responseTime}
          </span>
        </div>

        <h2 class="mb-3 text-2xl font-bold text-white">Lokalt snickerihantverk som känns tryggt att beställa</h2>
        <p class="mb-6 text-sm leading-relaxed text-slate-300">
          Vi hjälper kunder i {siteConfig.serviceAreaLabel.toLowerCase()} med fasadrenovering, altanbygge och uterum som är genomtänkta och lätta att förstå.
        </p>

        <div class="space-y-3">
          {trustHighlights.map((item) => (
            <div class="flex items-start gap-3 rounded-2xl border border-white/10 bg-white/5 p-4">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-[#f2a5b0]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              <span class="text-sm text-slate-200">{item}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
