---
interface HeroMetaItem {
  label: string;
  value: string;
}

interface Props {
  eyebrow: string;
  title: string;
  body: string;
  bgImage?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  meta?: HeroMetaItem[];
}

const {
  eyebrow,
  title,
  body,
  bgImage,
  primaryLabel,
  primaryHref,
  secondaryLabel,
  secondaryHref,
  meta = []
} = Astro.props;
---

<section class="mt-8 w-full max-w-7xl px-4 sm:px-6 lg:mt-12 lg:px-8 mx-auto">
  <div class="grid grid-cols-1 items-stretch gap-8 lg:grid-cols-12">
    <div class="relative isolate flex flex-col justify-center overflow-hidden rounded-[2rem] bg-primary p-8 shadow-xl sm:p-12 lg:col-span-8">
      {bgImage && (
        <>
          <div class="absolute inset-0 -z-20">
            <img src={bgImage} alt="" class="h-full w-full object-cover" />
          </div>
          <div class="absolute inset-0 -z-10 bg-gradient-to-r from-primary via-primary/80 to-transparent"></div>
        </>
      )}
      {!bgImage && (
        <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top_right,rgba(205,6,31,0.16),transparent_50%)]"></div>
      )}

      <span class="mb-6 inline-flex max-w-fit items-center rounded-full border border-[#CD061F]/20 bg-[#CD061F]/10 px-3 py-1 text-sm font-semibold text-[#CD061F] ring-1 ring-inset ring-[#CD061F]/20">
        {eyebrow}
      </span>

      <h1 class="mb-6 text-3xl font-extrabold leading-tight text-white sm:text-4xl md:text-5xl">
        {title}
      </h1>

      <p class="mb-8 max-w-2xl text-lg leading-relaxed text-slate-300">
        {body}
      </p>

      {
        (primaryHref || secondaryHref) && (
          <div class="mt-auto flex flex-col gap-4 sm:flex-row">
            {primaryHref && primaryLabel && (
              <a href={primaryHref} class="rounded-full bg-secondary px-8 py-3.5 text-center text-sm font-bold text-white shadow-sm transition-all hover:bg-[#b1051a] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#CD061F]">
                {primaryLabel}
              </a>
            )}
            {secondaryHref && secondaryLabel && (
              <a href={secondaryHref} class="rounded-full bg-white/10 px-8 py-3.5 text-center text-sm font-bold text-white ring-1 ring-inset ring-white/20 transition-all hover:bg-white/20">
                {secondaryLabel}
              </a>
            )}
          </div>
        )
      }
    </div>

    <aside class="flex flex-col rounded-[2rem] border border-slate-200 bg-white p-8 shadow-sm lg:col-span-4">
      <div class="mb-8">
        <span class="mb-2 block text-xs font-bold uppercase tracking-wider text-secondary">Snabbfakta</span>
        <h2 class="mb-3 text-xl font-bold text-slate-900">Det här kan du räkna med</h2>
        <p class="text-sm leading-relaxed text-slate-600">
          Tydlig kommunikation, praktiska lösningar och fokus på ett resultat som håller över tid.
        </p>
      </div>

      <div class="mt-auto grid grid-cols-2 gap-4">
        {
          meta.map((item) => (
            <div class="flex flex-col justify-center gap-1 rounded-xl border border-slate-100 bg-slate-50 p-4 transition-colors hover:border-[#CD061F]/20 hover:bg-[#CD061F]/5">
              <strong class="text-2xl font-extrabold text-slate-900">{item.value}</strong>
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500 sm:text-xs">{item.label}</span>
            </div>
          ))
        }
      </div>
    </aside>
  </div>
</section>
