---
import { testimonials } from "../data/site";
---

<section class="py-32 bg-surface">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="mb-20">
      <span class="text-secondary font-bold tracking-[0.2em] text-xs uppercase mb-4 block">Omdömen</span>
      <h2 class="font-headline text-4xl md:text-5xl font-extrabold text-on-surface leading-tight mb-8">Omdömen från Google.</h2>
      <p class="text-secondary-dim text-lg leading-relaxed max-w-2xl">
        Läs vad våra nöjda kunder säger om våra tjänster och upptäck varför de väljer att rekommendera oss till andra.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      {testimonials.map((testimonial) => (
        <div class="flex flex-col bg-surface-container-lowest p-8 md:p-10 rounded-3xl shadow-xl border border-outline-variant/10">
          <div class="flex gap-1 mb-6 text-secondary">
            {[1, 2, 3, 4, 5].map(() => (
              <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">star</span>
            ))}
          </div>
          <div class="flex items-center gap-4 border-t border-outline-variant/10 pt-6">
            <div class="w-10 h-10 bg-secondary-container rounded-full flex items-center justify-center text-on-secondary-container font-bold text-lg">
              {testimonial.name.charAt(0)}
            </div>
            <div>
              <h4 class="text-lg font-bold text-on-surface">{testimonial.name}</h4>
              <p class="text-secondary-dim font-medium uppercase tracking-widest text-[10px]">{testimonial.role}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Project Proof Images -->
    <div class="mt-20">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-8">
        <div class="max-w-xl">
          <span class="text-secondary font-bold tracking-[0.2em] text-xs uppercase mb-4 block">Utfört arbete</span>
          <h3 class="font-headline text-3xl font-bold text-on-surface leading-tight">Förtroende genom resultat.</h3>
        </div>
      </div>
      
      <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
        {testimonials.flatMap(t => t.images).slice(0, 5).map((img, i) => (
          <div class="relative group overflow-hidden rounded-2xl aspect-square shadow-lg">
            <img 
              src={img} 
              alt={`Projektbild ${i + 1}`} 
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-4">
              <span class="text-white text-[10px] font-bold uppercase tracking-wider">Utfört arbete</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
