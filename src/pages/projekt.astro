---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../data/site";
import referenceAltanDarkHouse from "../assets/seo/reference-altan-dark-house.jpg";
import referenceAltanEvening from "../assets/seo/reference-altan-evening.jpg";

const galleryImages = [
  {
    src: referenceAltanDarkHouse,
    alt: "Altanbygge utfört av snickare i Borås och Svenljunga",
    featured: true
  },
  {
    src: "/reference-fasad-white-outbuilding.jpg",
    alt: "Fasadrenovering utförd av snickare i Borås och Svenljunga"
  },
  {
    src: referenceAltanEvening,
    alt: "Altanbygge med belysning utfört av snickare i Borås och Svenljunga"
  },
  {
    src: "/service-about-fasad.webp",
    alt: "Fasadrenovering på villa i Borås och Svenljunga"
  },
  {
    src: "/service-about-uterum.webp",
    alt: "Uterum med trädetaljer byggt i Borås och Svenljunga"
  },
  {
    src: "/service-ref-new.webp",
    alt: "Referensbild från snickeriarbete i Borås och Svenljunga"
  },
  {
    src: "/614374637ac319ed0e56d8fc.webp",
    alt: "Altanbygge med trätrall i Borås och Svenljunga"
  },
  {
    src: "/614375647ac319ed0e56d905.webp",
    alt: "Detaljbild från snickeriarbete i Borås och Svenljunga"
  },
  {
    src: "/6143762d4d2345a2251cc83d.webp",
    alt: "Färdigt snickeriprojekt vid hus i Borås och Svenljunga"
  },
  {
    src: "/709d06fbbb16a3cd3e6b4d68fcf7094e40095ae8.webp",
    alt: "Referensbild från färdigt arbete i Borås och Svenljunga"
  },
  {
    src: "/altan.webp",
    alt: "Träaltan byggd av snickare i Borås och Svenljunga"
  }
];

const siteUrl = Astro.site?.toString().replace(/\/$/, "") || "https://ffinsnickeri.se";
const currentUrl = new URL(Astro.url.pathname, Astro.site).toString();

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Hem",
      item: siteUrl
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Referenser",
      item: currentUrl
    }
  ]
};
---

<BaseLayout
  title={`Referenser | ${siteConfig.businessName}`}
  description={`Jobb vi utfört inom fasadrenovering, altanbygge och uterum.`}
  schema={breadcrumbSchema}
>
  <section class="mx-auto w-full max-w-7xl px-4 pb-24 pt-32 sm:px-6 md:pt-36">
    <h1 class="font-headline text-4xl font-extrabold tracking-tight text-on-surface sm:text-5xl md:text-6xl">
      Referensprojekt i Borås & Svenljunga
    </h1>

    <div class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {galleryImages.map((image) => (
        <figure class={`overflow-hidden rounded-[1.75rem] border border-surface-container-high bg-surface-container-low shadow-sm transition-transform duration-300 hover:-translate-y-1 hover:shadow-xl ${image.featured ? "aspect-[4/3] sm:col-span-2 sm:aspect-[16/9]" : "aspect-[4/3]"}`}>
          {typeof image.src === "string" ? (
            <img
              src={image.src}
              alt={image.alt}
              class="h-full w-full object-cover"
              loading="lazy"
            />
          ) : (
            <Image
              src={image.src}
              format="webp"
              alt={image.alt}
              class="h-full w-full object-cover"
              loading="lazy"
            />
          )}
        </figure>
      ))}
    </div>
  </section>
</BaseLayout>
