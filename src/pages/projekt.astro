---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../data/site";

const galleryImages = [
  "/service-about-fasad.webp",
  "/service-about-uterum.webp",
  "/service-ref-new.webp",
  "/614374637ac319ed0e56d8fc.webp",
  "/614375647ac319ed0e56d905.webp",
  "/6143762d4d2345a2251cc83d.webp",
  "/709d06fbbb16a3cd3e6b4d68fcf7094e40095ae8.webp",
  "/altan.webp"
];
---

<BaseLayout
  title={`Referenser | ${siteConfig.businessName}`}
  description={`Jobb vi utfört inom fasadrenovering, altanbygge och uterum.`}
>
  <section class="mx-auto w-full max-w-7xl px-4 pb-24 pt-32 sm:px-6 md:pt-36">
    <h1 class="font-headline text-4xl font-extrabold tracking-tight text-on-surface sm:text-5xl md:text-6xl">
      Jobb vi utfört
    </h1>

    <div class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {galleryImages.map((src, index) => (
        <figure class={`overflow-hidden rounded-[1.75rem] border border-surface-container-high bg-surface-container-low shadow-sm transition-transform duration-300 hover:-translate-y-1 hover:shadow-xl ${index === 0 ? "sm:col-span-2" : ""}`}>
          <img
            src={src}
            alt={`Jobb utfört ${index + 1}`}
            class="h-full w-full object-cover"
            loading="lazy"
          />
        </figure>
      ))}
    </div>
  </section>
</BaseLayout>
