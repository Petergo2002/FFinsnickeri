---
import BaseLayout from "../layouts/BaseLayout.astro";
import { coreServices, secondaryCategories, siteConfig, trustPoints } from "../data/site";
import CtaPanel from "../components/CtaPanel.astro";

const values = [
  {
    title: "Tiotals års erfarenhet",
    body:
      "F.Finsnickeri verkstaden är en sammanslutning av snickare med lång erfarenhet av kvalitet, estetik och kundvärde.",
    icon: "handshake"
  },
  {
    title: "Lösningar för alla budgetar",
    body:
      "Vi tar fram genomtänkta snickerilösningar som anpassas efter både behov, uttryck och ekonomiska ramar.",
    icon: "settings_accessibility"
  },
  {
    title: "Kvalitet i varje detalj",
    body:
      "Med engagemang för kvalitet och kundens önskemål skapar vi resultat som känns både vackra och användbara.",
    icon: "eco"
  }
];

const stats = [
  { label: "Erfarenhet", value: "Tiotals år" },
  { label: "Tjänster", value: "3" },
  { label: "Områden", value: "2" },
  { label: "Område", value: siteConfig.city }
];

const siteUrl = Astro.site?.toString().replace(/\/$/, "") || "https://ffinsnickeri.se";
const currentUrl = new URL(Astro.url.pathname, Astro.site).toString();

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Hem",
      item: siteUrl
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Om oss",
      item: currentUrl
    }
  ]
};
---

<BaseLayout 
  title={`Om oss | ${siteConfig.businessName}`} 
  description={`Lär känna ${siteConfig.businessName} i ${siteConfig.city}. Vi hjälper dig med fasadrenovering, altanbygge och uterum.`}
  schema={breadcrumbSchema}
>
  <!-- Premium Hero Section -->
  <section class="relative flex min-h-[520px] items-center overflow-hidden bg-primary py-20 text-on-primary sm:min-h-[600px] sm:py-0">
    <div class="absolute inset-0 opacity-40">
      <img 
        class="w-full h-full object-cover" 
        src="/images/about_hero.png" 
        alt="Realistisk bild av ett välskött hem med genomtänkta snickeridetaljer" 
      />
      <div class="absolute inset-0 bg-gradient-to-t from-primary/80 via-primary/40 to-transparent"></div>
    </div>
    
    <div class="relative max-w-7xl mx-auto w-full px-4 sm:px-6 z-10 py-24">
      <div class="max-w-3xl">
        <span class="inline-block px-3 py-1 bg-tertiary-container text-on-tertiary-container rounded-full text-xs font-bold tracking-[0.2em] uppercase mb-6">
          Vår Historia
        </span>
        <h1 class="font-headline text-4xl sm:text-5xl md:text-7xl font-extrabold leading-[1.1] tracking-tight mb-8">
          F.Finsnickeri i Östra Frölunda <br/>
          <span class="text-secondary-fixed">för Borås & Svenljunga</span>
        </h1>
        <p class="text-lg sm:text-xl md:text-2xl text-on-primary/90 leading-relaxed mb-12 max-w-2xl">
          F.Finsnickeri verkstaden är en sammanslutning av snickare med tiotals års erfarenhet av kvalitet, estetik och kundvärde.
        </p>
        
        <div class="flex flex-wrap gap-4">
          <a href="/kontakt" class="bg-secondary text-on-secondary px-8 py-4 rounded-xl font-bold text-lg hover:bg-secondary-dim transition-all shadow-xl">
            Kontakta oss
          </a>
          <a href="/tjanster" class="border-2 border-white/30 text-white px-8 py-4 rounded-xl font-bold text-lg hover:bg-white/10 transition-all">
            Våra tjänster
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats/Trust Bar -->
  <section class="relative -mt-12 z-20 px-6">
    <div class="max-w-5xl mx-auto bg-surface-container-lowest shadow-2xl rounded-2xl grid grid-cols-2 md:grid-cols-4 divide-x divide-outline-variant/10 border border-outline-variant/5">
      {stats.map((stat) => (
        <div class="p-6 md:p-8 flex flex-col items-center text-center">
          <span class="text-2xl md:text-3xl font-bold text-primary mb-1">{stat.value}</span>
          <span class="text-xs font-bold text-secondary-dim uppercase tracking-widest">{stat.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Core Values Section (Tonal Layering) -->
  <section class="py-32 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="text-center max-w-3xl mx-auto mb-20">
        <span class="text-secondary font-bold tracking-[0.2em] text-xs uppercase mb-4 block">Vår Inriktning</span>
        <h2 class="font-headline text-4xl md:text-5xl font-extrabold text-on-surface leading-tight mb-6">
          Vi skapar vackra och användbara lösningar för hemmet
        </h2>
        <p class="text-on-surface-variant text-lg leading-relaxed">
          Vårt mål är att förse våra kunder med vacker och användbar design för deras hem, inredningar som betonar rummens skönhet och harmoni.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {values.map((value) => (
          <div class="p-10 bg-surface-container-low rounded-3xl border border-surface-container-high hover:bg-surface-container transition-all group">
            <div class="w-14 h-14 bg-secondary-container rounded-2xl flex items-center justify-center mb-8 text-on-secondary-container group-hover:scale-110 transition-transform">
              <span class="material-symbols-outlined text-3xl">{value.icon}</span>
            </div>
            <h3 class="text-2xl font-bold text-on-surface mb-4">{value.title}</h3>
            <p class="text-on-surface-variant leading-relaxed">{value.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Choose Us / Trust Points -->
  <section class="py-32 bg-surface-container">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
        <div class="order-2 lg:order-1">
          <span class="text-secondary font-bold tracking-[0.2em] text-xs uppercase mb-4 block">Så skapar vi värde</span>
          <h2 class="font-headline text-4xl md:text-5xl font-extrabold text-on-surface leading-tight mb-8">
            Det som gör skillnad i varje snickeriprojekt.
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-12 gap-y-10">
            {trustPoints.map((point) => (
              <div class="flex gap-4">
                <div class="flex-shrink-0 w-6 h-6 rounded-full bg-secondary/10 flex items-center justify-center mt-1">
                  <span class="material-symbols-outlined text-secondary text-base font-bold">check</span>
                </div>
                <div>
                  <h4 class="font-bold text-on-surface mb-2">{point.title}</h4>
                  <p class="text-on-surface-variant text-sm leading-relaxed">{point.body}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div class="relative order-1 overflow-hidden md:overflow-visible lg:order-2">
          <div class="absolute -top-10 -right-10 w-64 h-64 bg-secondary-container/30 rounded-full blur-3xl"></div>
          <div class="relative z-10 rounded-[2.5rem] overflow-hidden shadow-2xl aspect-square">
            <img 
              class="w-full h-full object-cover" 
              src="/images/swedish_houses.png" 
              alt="Vackra svenska trähus i harmonisk miljö som representerar vår hantverkskvalitet" 
            />
          </div>
          <div class="absolute -bottom-8 -left-8 bg-surface-container-lowest p-8 rounded-2xl shadow-xl z-20 border border-outline-variant/10 hidden md:block">
            <p class="text-secondary text-4xl font-extrabold mb-1">Estetik</p>
            <p class="text-on-surface font-bold text-sm uppercase tracking-wider">och funktion i balans</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Focus Areas -->
  <section class="py-32 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="mb-20">
        <span class="text-secondary font-bold tracking-[0.2em] text-xs uppercase mb-4 block">Våra fokusområden</span>
        <h2 class="font-headline text-4xl md:text-5xl font-extrabold text-on-surface leading-tight mb-6">
          Tre tjänster där vi kan göra störst skillnad
        </h2>
        <p class="text-on-surface-variant text-lg max-w-2xl leading-relaxed">
          Vi hjälper dig med fasadrenovering, altanbygge och uterum och formar varje lösning efter hemmet, önskemålen och budgeten.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        <div class="p-10 bg-surface-container-low rounded-[2rem] border border-surface-container-high relative overflow-hidden">
          <div class="absolute top-0 right-0 w-32 h-32 bg-secondary/5 rounded-full -translate-y-1/2 translate-x-1/2"></div>
          <h3 class="text-2xl font-bold text-on-surface mb-8 pb-4 border-b border-outline-variant/20 italic">
            Vårt fokus
          </h3>
          <ul class="space-y-8">
            {secondaryCategories.map((category) => (
              <li>
                <strong class="text-lg font-bold text-on-surface block mb-2">{category.name}</strong>
                <p class="text-on-surface-variant text-sm leading-relaxed">{category.summary}</p>
              </li>
            ))}
          </ul>
        </div>

        <div class="p-10 bg-primary/5 rounded-[2rem] border border-primary/10 relative overflow-hidden group">
          <div class="absolute top-0 right-0 w-32 h-32 bg-primary/10 rounded-full -translate-y-1/2 translate-x-1/2 group-hover:scale-110 transition-transform"></div>
          <h3 class="text-2xl font-bold text-primary mb-8 pb-4 border-b border-primary/20 italic">
            Våra tjänster
          </h3>
          <ul class="space-y-8">
            {coreServices.map((service) => (
              <li>
                <strong class="text-lg font-bold text-on-surface block mb-2">{service.name}</strong>
                <p class="text-on-surface-variant text-sm leading-relaxed">{service.summary}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <CtaPanel
    eyebrow="Kontakta Oss"
    title="Vill du diskutera ditt nästa snickeriprojekt?"
    body="Vi går igenom dina önskemål och tar fram en lösning som passar hemmet, uttrycket och budgeten."
    primaryHref="/kontakt"
    primaryLabel="Få kostnadsfri offert"
    secondaryHref="/projekt"
    secondaryLabel="Se våra projekt"
  />
</BaseLayout>

<style>
  /* Local overrides if needed, adhering to DESIGN.md principles */
  .font-headline {
    font-family: 'Manrope', sans-serif;
    letter-spacing: -0.02em;
  }
</style>
