---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../data/site";

const phoneHref = `tel:${siteConfig.primaryPhone.replace(/\s+/g, "")}`;
const siteUrl = Astro.site?.toString().replace(/\/$/, "") || "https://ffinsnickeri.se";
const currentUrl = new URL(Astro.url.pathname, Astro.site).toString();

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Hem",
      item: siteUrl
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Kontakt",
      item: currentUrl
    }
  ]
};
---

<BaseLayout 
  title={`Kontakta oss | ${siteConfig.businessName}`} 
  description={`Kontakta ${siteConfig.businessName} för offert och rådgivning.`}
  schema={breadcrumbSchema}
>
  <main class="pt-32 pb-20">
    <!-- Hero Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 mb-20">
      <div class="max-w-3xl">
        <span class="text-primary font-bold tracking-[0.1em] text-xs uppercase mb-4 block">HÖR AV DIG</span>
        <h1 class="text-4xl sm:text-5xl md:text-7xl font-headline font-extrabold text-on-background tracking-tighter mb-6 leading-tight">
          Kontakta <span class="text-primary">snickare i Borås & Svenljunga</span>.
        </h1>
        <p class="text-lg sm:text-xl text-secondary leading-relaxed max-w-2xl">
          Har du frågor om våra tjänster eller vill du begära en offert? Vi hjälper dig gärna med fasadrenovering, altanbygge och uterum.
        </p>
      </div>
    </section>

    <!-- Main Content Cluster -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 grid grid-cols-1 lg:grid-cols-12 gap-16">
      
      <!-- Contact Details Sidebar -->
      <aside class="lg:col-span-4 space-y-12 order-2 lg:order-1">
        <div class="space-y-8">
          <div class="group">
            <div class="flex items-center gap-4 mb-2">
              <svg class="text-primary w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              <h3 class="font-headline font-bold text-lg text-on-surface">Ring oss</h3>
            </div>
            <a href={phoneHref} class="block text-secondary pl-12 text-lg hover:text-primary transition-colors">{siteConfig.primaryPhone}</a>
          </div>
          
          <div class="group">
            <div class="flex items-center gap-4 mb-2">
              <svg class="text-primary w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              <h3 class="font-headline font-bold text-lg text-on-surface">E-post</h3>
            </div>
            <a href={`mailto:${siteConfig.primaryEmail}`} class="block break-all text-secondary pl-12 text-lg hover:text-primary transition-colors">{siteConfig.primaryEmail}</a>
          </div>
          
          <div class="group">
            <div class="flex items-center gap-4 mb-2">
              <svg class="text-primary w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              <h3 class="font-headline font-bold text-lg text-on-surface">Ort</h3>
            </div>
            <p class="text-secondary pl-12 text-lg leading-relaxed whitespace-pre-line">
              {siteConfig.address}
            </p>
          </div>
          
          <div class="group">
            <div class="flex items-center gap-4 mb-2">
              <svg class="text-primary w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <h3 class="font-headline font-bold text-lg text-on-surface">Öppettider</h3>
            </div>
            <div class="text-secondary pl-12 space-y-1 text-lg">
              <div class="flex justify-between max-w-[200px]"><span>Vardagar:</span> <span>{siteConfig.hours}</span></div>
              <div class="flex justify-between max-w-[200px]"><span>Lör - Sön:</span> <span>Stängt</span></div>
            </div>
          </div>
        </div>

        <!-- Map Block -->
        <div class="rounded-xl overflow-hidden shadow-sm bg-surface-container-low h-64 relative group">
          <div class="absolute inset-0 bg-slate-300">
            <img 
              alt="Verksamhetsområde för snickare i Östra Frölunda och Borås" 
              class="w-full h-full object-cover grayscale opacity-50 group-hover:grayscale-0 transition-all duration-700" 
              src="https://images.unsplash.com/photo-1524661135-423995f22d0b?q=80&w=800&auto=format&fit=crop&fm=webp"
            />
          </div>
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="bg-white/90 backdrop-blur px-4 py-2 rounded-lg shadow-lg flex items-center gap-2">
              <svg class="w-5 h-5 text-[#CD061F]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              <span class="font-bold text-[#CD061F] text-sm uppercase tracking-wider">Östra Frölunda</span>
            </div>
          </div>
        </div>
      </aside>

      <!-- Form Container -->
      <div class="lg:col-span-8 order-1 lg:order-2">
        <div class="bg-white p-8 md:p-12 rounded-xl shadow-[rgba(43,52,55,0.04)_0px_12px_40px] border border-outline-variant/10 relative overflow-hidden">
          
          <!-- Success Message (Hidden by default) -->
          <div id="success-message" class="hidden absolute inset-0 z-30 bg-white flex flex-col items-center justify-center text-center p-8 animate-in fade-in zoom-in duration-500">
            <div class="w-20 h-20 bg-primary/10 text-primary rounded-full flex items-center justify-center mb-6">
              <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <h2 class="text-3xl font-headline font-bold text-on-surface mb-4">Tack för din förfrågan!</h2>
            <p class="text-secondary text-lg max-w-sm mx-auto">
              Vi har tagit emot ditt meddelande och återkommer till dig så snart vi kan, vanligtvis inom 24 timmar.
            </p>
            <button onclick="location.reload()" class="mt-8 text-primary font-bold hover:underline flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
              Skicka ett till meddelande
            </button>
          </div>

          <h2 class="text-3xl font-headline font-bold text-on-surface mb-8">Skicka ett meddelande</h2>
          
          <form id="contact-form" class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6">
            <!-- Web3Forms Access Key & Configuration -->
            <input type="hidden" name="access_key" value="b7fdd035-7f52-4086-810b-db3a890d396c">
            <input type="hidden" name="subject" value="Ny förfrågan från hemsidan">
            <input type="hidden" name="from_name" value="F.Finsnickeri - Kontakt">
            <!-- Honeypot Spam Protection -->
            <input type="checkbox" name="botcheck" class="hidden" style="display: none;">

            <div class="space-y-2">
              <label class="block text-xs font-bold uppercase tracking-widest text-on-surface-variant font-label">Namn</label>
              <input 
                type="text" 
                name="name" 
                required
                class="w-full bg-surface-container-low border-outline-variant/30 rounded-lg px-4 py-3 focus:ring-2 focus:ring-primary focus:border-primary transition-all outline-none text-on-surface" 
                placeholder="Ditt fullständiga namn" 
              />
            </div>
            
            <div class="space-y-2">
              <label class="block text-xs font-bold uppercase tracking-widest text-on-surface-variant font-label">Telefon</label>
              <input 
                type="tel" 
                name="phone" 
                class="w-full bg-surface-container-low border-outline-variant/30 rounded-lg px-4 py-3 focus:ring-2 focus:ring-primary focus:border-primary transition-all outline-none text-on-surface" 
                placeholder="070-000 00 00" 
              />
            </div>
            
            <div class="space-y-2 md:col-span-2">
              <label class="block text-xs font-bold uppercase tracking-widest text-on-surface-variant font-label">E-post</label>
              <input 
                type="email" 
                name="email" 
                required
                class="w-full bg-surface-container-low border-outline-variant/30 rounded-lg px-4 py-3 focus:ring-2 focus:ring-primary focus:border-primary transition-all outline-none text-on-surface" 
                placeholder={siteConfig.primaryEmail} 
              />
            </div>
            
            <div class="space-y-2 md:col-span-2">
              <label class="block text-xs font-bold uppercase tracking-widest text-on-surface-variant font-label">Tjänst av intresse</label>
              <select name="service" class="w-full bg-surface-container-low border-outline-variant/30 rounded-lg px-4 py-3 focus:ring-2 focus:ring-primary focus:border-primary transition-all outline-none text-on-surface appearance-none">
                <option value="">Välj en tjänst...</option>
                <option value="Fasadrenovering">Fasadrenovering</option>
                <option value="Altanbygge">Altanbygge</option>
                <option value="Uterum">Uterum</option>
                <option value="Övrigt">Övrigt</option>
              </select>
            </div>
            
            <div class="space-y-2 md:col-span-2">
              <label class="block text-xs font-bold uppercase tracking-widest text-on-surface-variant font-label">Meddelande</label>
              <textarea 
                name="message" 
                rows="5" 
                required
                class="w-full bg-surface-container-low border-outline-variant/30 rounded-lg px-4 py-3 focus:ring-2 focus:ring-primary focus:border-primary transition-all outline-none text-on-surface resize-none" 
                placeholder="Beskriv ditt ärende..."
              ></textarea>
            </div>
            
            <div id="error-message" class="hidden md:col-span-2 p-4 bg-red-50 text-red-600 rounded-lg text-sm font-medium">
              Ett fel uppstod. Kontrollera din anslutning och försök igen.
            </div>

            <div class="md:col-span-2 pt-4 flex flex-col items-start">
              <button 
                type="submit" 
                id="submit-button"
                class="w-full md:w-auto bg-[#CD061F] text-white px-10 py-4 rounded-lg font-bold text-lg hover:bg-[#b1051a] shadow-lg shadow-[#CD061F]/20 flex items-center justify-center gap-2 transition-all disabled:opacity-70 disabled:cursor-not-allowed group"
              >
                <span class="submit-text">Skicka förfrågan</span>
                <span class="loading-spinner hidden">
                  <svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                  </svg>
                </span>
                <svg class="w-5 h-5 group-enabled:group-hover:translate-x-1 transition-transform arrow-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </button>
              <p class="text-xs text-secondary mt-4 max-w-md">
                Genom att skicka formuläret godkänner du vår hantering av personuppgifter. Vi svarar vanligtvis inom {siteConfig.responseTime.toLowerCase()}.
              </p>
            </div>
          </form>
        </div>
      </div>
    </section>

    <!-- Trust Indicator Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 mt-32">
      <div class="bg-[#CD061F]/5 border border-[#CD061F]/10 rounded-xl p-12 text-center">
        <h3 class="font-headline font-bold text-2xl text-on-surface mb-4">Vill du bolla idéer direkt?</h3>
        <p class="text-secondary text-lg mb-8 max-w-xl mx-auto">Ring oss gärna om du vill diskutera fasadrenovering, altanbygge eller uterum och få snabb vägledning kring nästa steg.</p>
        <a href={phoneHref} class="inline-flex items-center justify-center gap-3 bg-white text-[#CD061F] border border-[#CD061F]/20 px-8 py-4 rounded-xl font-bold font-headline shadow-sm hover:shadow-md transition-shadow">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
          Ring oss: {siteConfig.primaryPhone}
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

<script is:inline>
  const form = document.getElementById('contact-form');
  const successMessage = document.getElementById('success-message');
  const errorMessage = document.getElementById('error-message');
  const submitButton = document.getElementById('submit-button');
  const submitText = submitButton.querySelector('.submit-text');
  const loadingSpinner = submitButton.querySelector('.loading-spinner');
  const arrowIcon = submitButton.querySelector('.arrow-icon');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    // UI state: Loading
    submitButton.disabled = true;
    submitText.textContent = "Skickar...";
    loadingSpinner.classList.remove('hidden');
    arrowIcon.classList.add('hidden');
    errorMessage.classList.add('hidden');

    const formData = new FormData(form);
    const object = Object.fromEntries(formData);
    const json = JSON.stringify(object);

    try {
      const response = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "Accept": "application/json",
        },
        body: json,
      });

      const result = await response.json();

      if (response.ok) {
        // UI state: Success
        successMessage.classList.remove('hidden');
        form.reset();
      } else {
        // UI state: Error from server
        console.error(result);
        errorMessage.textContent = result.message || "Ett fel uppstod när meddelandet skulle skickas.";
        errorMessage.classList.remove('hidden');
        resetButton();
      }
    } catch (error) {
      // UI state: Network error
      console.error(error);
      errorMessage.textContent = "Kunde inte skicka meddelandet. Kontrollera din internetanslutning.";
      errorMessage.classList.remove('hidden');
      resetButton();
    }
  });

  function resetButton() {
    submitButton.disabled = false;
    submitText.textContent = "Skicka förfrågan";
    loadingSpinner.classList.add('hidden');
    arrowIcon.classList.remove('hidden');
  }
</script>
