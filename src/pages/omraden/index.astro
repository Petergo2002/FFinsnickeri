---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaPanel from "../../components/CtaPanel.astro";
import PageHero from "../../components/PageHero.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { areas, siteConfig } from "../../data/site";

const siteUrl = Astro.site?.toString().replace(/\/$/, "") || "https://ffinsnickeri.se";
const currentUrl = new URL(Astro.url.pathname, Astro.site).toString();

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Hem",
      item: siteUrl
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Verksamhetsområden",
      item: currentUrl
    }
  ]
};
---

<BaseLayout
  title={`Verksamhetsområden | ${siteConfig.businessName}`}
  description={`Områden där ${siteConfig.businessName} arbetar.`}
  schema={breadcrumbSchema}
>
  <div class="flex flex-col gap-16 pb-24 md:gap-24">
    <PageHero
      eyebrow="Verksamhetsområden"
      title="Snickare i Borås, Svenljunga & Göteborg"
      body={`Vår bas finns i ${siteConfig.city}, och vi hjälper kunder i Borås och Svenljunga med fasadrenovering, altanbygge och uterum.`}
      primaryHref="/kontakt"
      primaryLabel="Kontakta oss"
      secondaryHref="/tjanster"
      secondaryLabel="Se tjänster"
      meta={[
        { label: "Orter", value: String(areas.length) },
        { label: "Bas", value: "Östra Frölunda" },
        { label: "Svarstid", value: "Snabb" },
        { label: "Erfarenhet", value: "Tiotals år" }
      ]}
    />

    <section class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionHeading
        eyebrow="Orter"
        title="Här finns vi nära till hands"
        body="Vi utgår från Östra Frölunda och arbetar löpande i Borås och Svenljunga med snickerilösningar för hem och utemiljö."
      />
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-3">
        {
          areas.map((area) => (
            <article class={`flex items-start gap-4 rounded-2xl border border-slate-100 bg-white p-6 shadow-sm transition-all ${!area.hasNoPage ? 'hover:border-[#CD061F]/20 hover:shadow-md' : 'opacity-80'}`}>
              <div class="mt-1 shrink-0">
                <svg class="h-6 w-6 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              </div>
              <div>
                <h3 class="mb-1 text-lg font-bold text-slate-900">{area.name}</h3>
                <p class="text-sm leading-relaxed text-slate-600">{area.summary}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <CtaPanel
      eyebrow="Planera rätt"
      title="Undrar du om vi kan hjälpa dig i ditt område?"
      body="Hör av dig med plats och typ av projekt så återkommer vi snabbt med besked om upplägg och tillgänglighet."
      primaryHref="/kontakt"
      primaryLabel="Kontakta oss"
      secondaryHref="/projekt"
      secondaryLabel="Se våra projekt"
    />
  </div>
</BaseLayout>
