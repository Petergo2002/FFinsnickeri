---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaPanel from "../../components/CtaPanel.astro";
import PageHero from "../../components/PageHero.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import {
  areas,
  projectCases,
  serviceDetails,
  siteConfig,
  testimonials,
  type Area
} from "../../data/site";

export function getStaticPaths() {
  return areas
    .filter((area) => !area.hasNoPage)
    .map((area) => ({
      params: { area: area.slug },
      props: { area }
    }));
}

interface Props {
  area: Area;
}

const { area } = Astro.props;
const siteUrl = Astro.site?.toString().replace(/\/$/, "") || "https://ffinsnickeri.se";
const currentUrl = new URL(Astro.url.pathname, Astro.site).toString();
const phoneHref = `tel:${siteConfig.primaryPhone.replace(/\s+/g, "")}`;

const matchingProjects = projectCases
  .filter((project) => project.location.toLowerCase() === area.name.toLowerCase())
  .slice(0, 3);

const matchingTestimonials = testimonials
  .filter((testimonial) => testimonial.role.toLowerCase().includes(area.name.toLowerCase()))
  .slice(0, 2);

const otherAreas = areas.filter((item) => !item.hasNoPage && item.slug !== area.slug);
const priorityServices = (area.priorityServiceSlugs ?? [])
  .map((slug) => serviceDetails.find((service) => service.slug === slug))
  .filter((service) => service !== undefined);
const orderedServices = [
  ...priorityServices,
  ...serviceDetails.filter(
    (service) => !priorityServices.some((priorityService) => priorityService.slug === service.slug)
  )
];
const pageTitle =
  area.seoTitle ?? `Snickare i ${area.name} | Altan, fasad & uterum | ${siteConfig.businessName}`;
const pageDescription =
  area.seoDescription ??
  `Behöver du snickare i ${area.name}? ${siteConfig.businessName} hjälper med fasadrenovering, altanbygge och uterum. Tydlig planering och kostnadsfri offert.`;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Hem",
      item: siteUrl
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Verksamhetsområden",
      item: `${siteUrl}/omraden/`
    },
    {
      "@type": "ListItem",
      position: 3,
      name: `Snickare i ${area.name}`,
      item: currentUrl
    }
  ]
};

const serviceListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": `${currentUrl}#services`,
  name: `Snickeritjänster i ${area.name}`,
  description: pageDescription,
  itemListElement: orderedServices.map((service, index) => ({
    "@type": "ListItem",
    position: index + 1,
    item: {
      "@type": "Service",
      name: `${service.name} i ${area.name}`,
      serviceType: service.name,
      url: `${siteUrl}/tjanster/${service.slug}/${area.slug}/`,
      provider: {
        "@id": `${siteUrl}/#organization`
      },
      areaServed: {
        "@type": "City",
        name: area.name
      }
    }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schema={[breadcrumbSchema, serviceListSchema]}
>
  <div class="flex flex-col gap-16 pb-24 md:gap-24">
    <PageHero
      eyebrow="Verksamhetsområde"
      title={`Snickare i ${area.name}`}
      body={`${area.localSearchIntro ?? area.summary} Vi utgår från ${siteConfig.city} och planerar varje projekt med tydlig dialog, rätt materialval och fokus på ett hållbart slutresultat.`}
      bgImage="/service-about-fasad.webp"
      primaryHref="/kontakt"
      primaryLabel="Begär offert"
      secondaryHref={phoneHref}
      secondaryLabel={`Ring ${siteConfig.primaryPhone}`}
      meta={[
        { label: "Ort", value: area.name },
        { label: "Tjänster", value: String(serviceDetails.length) },
        { label: "Bas", value: siteConfig.city },
        { label: "Svarstid", value: "Snabb" }
      ]}
    />

    <section class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-3">
        <div>
          <span class="mb-3 block text-sm font-bold uppercase tracking-wider text-secondary">Lokalt upplägg</span>
          <h2 class="text-3xl font-extrabold text-slate-900 sm:text-4xl">Så hjälper vi kunder i {area.name}</h2>
        </div>
        <div class="grid grid-cols-1 gap-6 lg:col-span-2 md:grid-cols-3">
          <article class="rounded-2xl border border-slate-100 bg-white p-6 shadow-sm">
            <h3 class="mb-3 text-lg font-bold text-slate-900">Arbetsområde</h3>
            <p class="text-sm leading-relaxed text-slate-600">{area.coverageNote}</p>
          </article>
          <article class="rounded-2xl border border-slate-100 bg-white p-6 shadow-sm">
            <h3 class="mb-3 text-lg font-bold text-slate-900">Lokal erfarenhet</h3>
            <p class="text-sm leading-relaxed text-slate-600">{area.localProof}</p>
          </article>
          <article class="rounded-2xl border border-slate-100 bg-white p-6 shadow-sm">
            <h3 class="mb-3 text-lg font-bold text-slate-900">Nästa steg</h3>
            <p class="text-sm leading-relaxed text-slate-600">{area.conversionFocus ?? area.responseNote}</p>
          </article>
        </div>
      </div>
      {area.proofPoints && area.proofPoints.length > 0 && (
        <div class="mt-10 rounded-2xl border border-secondary/10 bg-secondary-container/25 p-6 md:p-8">
          <h3 class="mb-5 text-xl font-extrabold text-slate-900">Varför sidan är relevant för {area.name}</h3>
          <ul class="grid grid-cols-1 gap-4 md:grid-cols-3">
            {area.proofPoints.map((point) => (
              <li class="flex gap-3 text-sm leading-relaxed text-slate-700">
                <span class="material-symbols-outlined mt-0.5 text-xl text-secondary">verified</span>
                <span>{point}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </section>

    <section class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
      <SectionHeading
        eyebrow="Tjänster"
        title={`Fasadrenovering, altanbygge och uterum i ${area.name}`}
        body={`Välj den tjänst som passar ditt projekt. Varje sida innehåller mer information om upplägg, vanliga frågor och lokala förutsättningar i ${area.name}.`}
      />
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {orderedServices.map((service) => (
          <a
            href={`/tjanster/${service.slug}/${area.slug}`}
            class="group flex h-full flex-col rounded-2xl border border-slate-100 bg-white p-8 shadow-sm transition-all hover:border-secondary/30 hover:shadow-lg"
          >
            <span class="mb-5 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-secondary-container text-on-secondary-container">
              <span class="material-symbols-outlined">handyman</span>
            </span>
            <h3 class="text-xl font-bold text-slate-900 transition-colors group-hover:text-secondary">{service.name} i {area.name}</h3>
            <p class="mt-3 flex-grow text-sm leading-relaxed text-slate-600">{service.areaSeoDescription}</p>
            <div class="mt-6 flex items-center text-sm font-bold uppercase tracking-wider text-secondary">
              Läs mer
              <span class="material-symbols-outlined ml-1 text-base transition-transform group-hover:translate-x-1">arrow_forward</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    {(matchingProjects.length > 0 || matchingTestimonials.length > 0) && (
      <section class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
        <SectionHeading
          eyebrow="Referenser"
          title={`Lokala bevis från ${area.name}`}
          body="Se exempel på utfört arbete och kundrespons som visar hur vi arbetar med tydlighet, noggrannhet och kvalitet."
        />
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
          {matchingProjects.map((project) => (
            <article class="overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-sm">
              <img src={project.image} alt={`${project.service} i ${project.location}`} class="h-56 w-full object-cover" loading="lazy" />
              <div class="p-6">
                <span class="mb-2 block text-xs font-bold uppercase tracking-wider text-secondary">{project.service} · {project.location}</span>
                <h3 class="text-xl font-bold text-slate-900">{project.title}</h3>
                <p class="mt-3 text-sm leading-relaxed text-slate-600">{project.result}</p>
              </div>
            </article>
          ))}

          {matchingTestimonials.map((testimonial) => (
            <article class="rounded-2xl border border-slate-100 bg-white p-8 shadow-sm">
              <div class="mb-5 flex gap-1 text-secondary" aria-label="5 av 5 stjärnor">
                {[1, 2, 3, 4, 5].map(() => (
                  <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">star</span>
                ))}
              </div>
              <p class="text-sm leading-relaxed text-slate-600">
                {testimonial.text || "Kundomdöme registrerat för utfört arbete."}
              </p>
              <div class="mt-6 border-t border-slate-100 pt-5">
                <strong class="block text-slate-900">{testimonial.name}</strong>
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">{testimonial.role}</span>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    <section class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-2xl border border-secondary/10 bg-secondary-container/30 p-8 md:p-10">
        <div class="mb-8 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
          <div>
            <span class="mb-3 block text-xs font-bold uppercase tracking-[0.2em] text-secondary">Närliggande områden</span>
            <h2 class="text-2xl font-extrabold text-slate-900 md:text-3xl">Fler orter där vi hjälper kunder</h2>
          </div>
          <a href="/omraden" class="inline-flex items-center gap-2 text-sm font-bold uppercase tracking-wider text-secondary">
            Alla områden
            <span class="material-symbols-outlined text-base">arrow_forward</span>
          </a>
        </div>
        <div class="flex flex-wrap gap-3">
          {otherAreas.map((otherArea) => (
            <a
              href={`/omraden/${otherArea.slug}`}
              class="rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition-all hover:border-secondary hover:text-secondary"
            >
              Snickare i {otherArea.name}
            </a>
          ))}
        </div>
      </div>
    </section>

    <CtaPanel
      eyebrow={`Snickare i ${area.name}`}
      title="Vill du få ett tydligt offertunderlag?"
      body={`Beskriv projektet, skicka gärna bilder och berätta var i ${area.name} arbetet ska utföras. Vi återkommer med nästa steg.`}
      primaryHref="/kontakt"
      primaryLabel="Begär kostnadsfri offert"
      secondaryHref={phoneHref}
      secondaryLabel={`Ring oss: ${siteConfig.primaryPhone}`}
    />
  </div>
</BaseLayout>
