---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaPanel from "../components/CtaPanel.astro";
import Testimonials from "../components/Testimonials.astro";
import {
  knallenServices,
  projectCases,
  siteConfig,
  trustPoints
} from "../data/site";

const homepageServiceSlugs = [
  "fasadrenovering",
  "altanbygge",
  "uterum"
] as const;

const homepageServices = homepageServiceSlugs
  .map((slug) => knallenServices.find((service) => service.slug === slug))
  .filter((service) => service !== undefined);
---

<BaseLayout
  title={`${siteConfig.businessName} | Finsnickeri & Fasadrenovering i Borås & Svenljunga`}
  description={`Letar du efter finsnickeri i Borås eller Svenljunga? ${siteConfig.businessName} hjälper dig med fasadrenovering, altanbygge och uterum med fokus på kvalitet och estetik.`}
>
  <!-- Hero Section -->
  <section class="relative flex min-h-[720px] items-center overflow-hidden bg-primary py-24 text-on-primary sm:min-h-[870px] sm:py-0">
    <div class="absolute inset-0 opacity-40">
      <img class="w-full h-full object-cover" alt="Vackert trädhus i Sverige som representerar professionellt snickeriarbete" src="/hero_swedish_house.png" />
      <div class="absolute inset-0 bg-gradient-to-r from-primary via-primary/80 to-transparent"></div>
    </div>
    <div class="relative max-w-7xl mx-auto w-full px-4 sm:px-6 z-10">
      <div class="max-w-3xl">
        <span class="inline-block px-3 py-1 bg-tertiary-container text-on-tertiary-container rounded-full text-xs font-bold tracking-widest uppercase mb-6">Proffs på snickeri i Borås & Svenljunga</span>
        <h1 class="font-headline text-4xl sm:text-5xl md:text-7xl font-extrabold leading-tight tracking-tight mb-8">
          Finsnickeri & Fasadrenovering i Borås & Svenljunga
        </h1>
        <p class="text-lg sm:text-xl md:text-2xl text-on-primary/90 leading-relaxed mb-12 max-w-2xl">
          {siteConfig.businessName} förvandlar ditt hem med skräddarsydda snickerilösningar, från altanbygge till kompletta fasadrenoveringar.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/kontakt" class="bg-surface-container-lowest text-primary px-8 py-4 rounded-xl font-bold text-lg hover:bg-surface-bright transition-all shadow-xl">
            Få ett kostnadsförslag
          </a>
          <a href="/tjanster" class="border-2 border-on-primary/30 text-on-primary px-8 py-4 rounded-xl font-bold text-lg hover:bg-white/10 transition-all">
            Se våra tjänster
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Bar -->
  <section class="relative -mt-16 z-20 px-6">
    <div class="max-w-5xl mx-auto bg-surface-container-lowest shadow-xl rounded-2xl grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-outline-variant/10">
      <div class="p-8 flex flex-col items-center text-center">
        <span class="material-symbols-outlined text-secondary text-4xl mb-3">apartment</span>
        <span class="text-3xl font-bold text-on-surface">Område</span>
        <span class="text-secondary-dim font-medium">Borås & Svenljunga</span>
      </div>
      <div class="p-8 flex flex-col items-center text-center">
        <span class="material-symbols-outlined text-secondary text-4xl mb-3">history</span>
        <span class="text-3xl font-bold text-on-surface">10+ år</span>
        <span class="text-secondary-dim font-medium">Erfarenhet</span>
      </div>
      <div class="p-8 flex flex-col items-center text-center">
        <span class="material-symbols-outlined text-secondary text-4xl mb-3">schedule</span>
        <span class="text-3xl font-bold text-on-surface">24h</span>
        <span class="text-secondary-dim font-medium">Återkoppling</span>
      </div>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="py-32 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-20 gap-8">
        <div class="max-w-2xl">
          <span class="text-secondary font-bold tracking-[0.2em] text-xs uppercase mb-4 block">Våra Tjänster</span>
          <h2 class="font-headline text-4xl md:text-5xl font-extrabold text-on-surface leading-tight">Tre snickeritjänster med fokus på hem, harmoni och kvalitet.</h2>
        </div>
        <p class="text-secondary-dim text-lg max-w-sm">Vi erbjuder exakt det vi gör bäst: fasadrenovering, altanbygge och uterum i Borås och Svenljunga.</p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {homepageServices.map((service) => (
          <a href={`/tjanster/${service.slug}`} class="group flex flex-col p-8 bg-surface-container-low rounded-2xl border border-surface-container-high hover:bg-surface-container hover:border-secondary-container transition-all hover:shadow-lg h-full">
            <span class="material-symbols-outlined text-secondary text-3xl mb-6 block transition-transform group-hover:scale-110">handyman</span>
            <h3 class="font-bold text-xl text-on-surface group-hover:text-secondary transition-colors mb-2">{service.name}</h3>
            <p class="text-secondary-dim text-sm leading-relaxed flex-grow">{service.heroSubtitle}</p>
            <div class="mt-6 flex items-center text-sm font-bold uppercase tracking-wider text-secondary">
              Läs mer
              <span class="material-symbols-outlined ml-1 text-base transition-transform group-hover:translate-x-1">arrow_forward</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>


  <!-- Why Choose Us -->
  <section class="py-32 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
        <div class="relative overflow-hidden md:overflow-visible">
          <div class="absolute -top-10 -left-10 w-40 h-40 bg-secondary-container rounded-full blur-3xl"></div>
          <img class="rounded-3xl shadow-2xl relative z-10 w-full object-cover aspect-[4/5]" alt="Fasadrenovering utförd av professionell snickare" src="/service-about-fasad.webp" />
          <div class="absolute -bottom-8 -right-8 bg-surface-container-lowest p-8 rounded-2xl shadow-xl z-20 hidden md:block border border-outline-variant/10">
            <p class="text-secondary text-4xl font-extrabold mb-1">Metod &</p>
            <p class="text-on-surface font-bold text-sm uppercase tracking-wider">Trygg Leverans</p>
          </div>
        </div>
        <div>
          <span class="text-secondary font-bold tracking-[0.2em] text-xs uppercase mb-4 block">Varför välja oss</span>
          <h2 class="font-headline text-4xl md:text-5xl font-extrabold text-on-surface leading-tight mb-12">Snickeriprojekt med tydlig riktning.</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-12">
            {trustPoints.map((point) => (
              <div>
                <div class="w-12 h-12 bg-secondary-container rounded-xl flex items-center justify-center mb-6 text-on-secondary-container font-extrabold">
                  <span class="material-symbols-outlined">check_circle</span>
                </div>
                <h4 class="text-lg font-bold text-on-surface mb-3">{point.title}</h4>
                <p class="text-secondary-dim leading-relaxed">{point.body}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <Testimonials />

  <CtaPanel
    eyebrow="Kontakta Oss"
    title="Behöver du hjälp med ditt nästa snickeriprojekt?"
    body={siteConfig.footerNote}
    primaryHref="/kontakt"
    primaryLabel="Kontakta oss"
    secondaryHref="/tjanster"
    secondaryLabel="Se våra tjänster"
  />
</BaseLayout>
