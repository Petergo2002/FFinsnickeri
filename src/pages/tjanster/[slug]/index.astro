---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CtaPanel from "../../../components/CtaPanel.astro";
import {
  areas,
  serviceDetails,
  siteConfig,
  type ServiceDetail
} from "../../../data/site";

export function getStaticPaths() {
  return serviceDetails.map((service) => ({
    params: { slug: service.slug },
    props: { service }
  }));
}

interface Props {
  service: ServiceDetail;
}

const { service } = Astro.props;
const siteUrl = Astro.site?.toString().replace(/\/$/, "") || "https://ffinsnickeri.se";
const currentUrl = new URL(Astro.url.pathname, Astro.site).toString();
const relatedServices = serviceDetails.filter((item) => item.slug !== service.slug);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Hem",
      item: siteUrl
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Tjänster",
      item: `${siteUrl}/tjanster/`
    },
    {
      "@type": "ListItem",
      position: 3,
      name: service.name,
      item: currentUrl
    }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${currentUrl}#service`,
  name: service.name,
  serviceType: service.name,
  description: service.seoDescription,
  url: currentUrl,
  image: new URL(service.image, Astro.site).toString(),
  provider: {
    "@id": `${siteUrl}/#organization`
  },
  areaServed: [
    { "@type": "City", name: "Borås" },
    { "@type": "City", name: "Svenljunga" },
    { "@type": "City", name: "Göteborg" }
  ]
};
---

<BaseLayout
  title={service.seoTitle}
  description={service.seoDescription}
  image={service.image}
  schema={[breadcrumbSchema, serviceSchema]}
>
  <!-- Hero Section -->
  <section class="relative flex min-h-[620px] flex-col justify-center overflow-hidden bg-primary pt-16 pb-12 md:h-[716px] md:py-0">
    <div class="absolute inset-0 opacity-60">
      <img alt={`${service.name} utförd av snickare i Borås och Svenljunga`} class="w-full h-full object-cover" src={service.image} />
    </div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#4f6073] via-[#4f6073]/80 to-transparent"></div>
    <div class="relative max-w-7xl mx-auto w-full px-4 sm:px-6 z-10">
      <div class="max-w-2xl">
        <!-- Breadcrumb -->
        <nav class="mb-6 flex items-center gap-2 text-sm text-white/70 font-medium">
          <a href="/" class="hover:text-white transition-colors">Hem</a>
          <span>/</span>
          <a href="/tjanster" class="hover:text-white transition-colors">Tjänster</a>
          <span>/</span>
          <span class="text-white">{service.name}</span>
        </nav>
        
        <span class="inline-block py-1 px-3 mb-6 bg-[#CD061F] text-white text-xs font-bold tracking-widest rounded-full uppercase">Tjänst</span>
        <h1 class="font-headline text-4xl sm:text-5xl md:text-7xl font-extrabold text-white tracking-tighter mb-6 leading-[1.1]">
          {service.name} i Borås & Svenljunga
        </h1>
        <p class="text-lg sm:text-xl text-white/90 mb-10 font-light leading-relaxed">
          {service.heroSubtitle}
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/kontakt" class="bg-[#CD061F] text-white px-8 py-4 rounded-lg font-bold text-lg shadow-xl hover:bg-[#b1051a] transition-all text-center">
            Boka kostnadsfritt hembesök
          </a>
          <a href="/tjanster" class="border border-white/30 text-white px-8 py-4 rounded-lg font-bold text-lg hover:bg-white/10 transition-all text-center">
            Se alla tjänster
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- About Service -->
  <section class="py-24 bg-surface">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="text-center">
        <span class="text-sm font-bold tracking-[0.2em] text-outline uppercase block mb-4">Om tjänsten</span>
        <h2 class="font-headline text-4xl font-bold text-on-surface mb-10 tracking-tight">{service.name}</h2>
        <div class="space-y-6 text-on-surface-variant text-lg leading-relaxed text-left max-w-3xl mx-auto">
          {service.about.map((paragraph) => <p>{paragraph}</p>)}
          <p>
            Vill du jämföra upplägg, material eller budget innan du bestämmer dig?{" "}
            <a href="/kontakt" class="font-semibold text-secondary underline decoration-secondary/30 underline-offset-4 hover:text-secondary-dim">
              kontakta oss för offert
            </a>
            .
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="py-24 bg-surface-container-low">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-16">
          <h2 class="font-headline text-4xl font-bold text-on-surface mb-4">Därför väljer kunder oss</h2>
        <p class="text-secondary max-w-xl mx-auto">Vi kombinerar personlig service med erfarenhet och kvalitet för att ge ditt hem rätt resultat.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {service.usps.map((usp) => (
          <div class="bg-surface-container-lowest p-8 rounded-xl border border-outline-variant/10 hover:bg-surface-container-high transition-all group">
            <div class="w-12 h-12 bg-[#CD061F]/10 text-[#CD061F] rounded-lg flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <h3 class="font-bold text-xl mb-3">{usp.title}</h3>
            <p class="text-on-surface-variant text-sm leading-relaxed">{usp.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  {service.processSteps.length > 0 && (
    <section class="py-24 bg-surface">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-6">
          <div class="max-w-xl">
            <span class="text-sm font-bold tracking-[0.2em] text-outline uppercase block mb-4">Processen</span>
            <h2 class="font-headline text-4xl font-bold text-on-surface">Så här går det till</h2>
          </div>
          <p class="text-on-surface-variant md:max-w-xs">Ett strukturerat flöde som säkerställer kvalitet från första kontakt till slutbesiktning.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 relative">
          {service.processSteps.map((step, idx) => (
            <div class="relative z-10">
              <div class="text-6xl font-black text-slate-100 mb-4 font-headline">0{idx + 1}</div>
              <h4 class="font-bold text-lg mb-2">{step.title}</h4>
              <p class="text-on-surface-variant text-sm">{step.body}</p>
              {idx < service.processSteps.length - 1 && (
                <div class="hidden md:block absolute top-10 right-0 w-1/2 h-[2px] bg-slate-100 -z-10"></div>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Areas we work in -->
  <section class="py-24 bg-surface-container-low overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-16 items-center">
        <div class="lg:col-span-1">
          <h2 class="font-headline text-3xl font-bold text-on-surface mb-6">Områden vi verkar i</h2>
          <p class="text-on-surface-variant mb-8">Vi utgår från Östra Frölunda och arbetar i Borås och Svenljunga. Hittar du inte din ort? Kontakta oss för en förfrågan.</p>
          <div class="flex flex-wrap gap-2">
            {areas.map(area => (
              area.hasNoPage ? (
                <div class="px-4 py-2 bg-slate-100 text-slate-500 text-sm font-semibold rounded-full border border-slate-200 cursor-default">
                  {service.name} i {area.name}
                </div>
              ) : (
                <a
                  href={`/tjanster/${service.slug}/${area.slug}`}
                  class="px-4 py-2 bg-white text-slate-700 text-sm font-semibold rounded-full border border-slate-200 hover:border-secondary hover:text-secondary transition-all"
                >
                  {service.name} i {area.name}
                </a>
              )
            ))}
          </div>
        </div>
        <div class="relative h-[300px] overflow-hidden rounded-2xl border-4 border-white shadow-xl sm:h-[360px] lg:col-span-2 lg:h-[400px]">
          <div class="absolute inset-0 bg-slate-200">
            <img alt={`Verksamhetsområde för ${service.name.toLowerCase()} i Borås och Svenljunga`} class="w-full h-full object-cover grayscale opacity-80" src="https://images.unsplash.com/photo-1524661135-423995f22d0b?q=80&w=800&auto=format&fit=crop&fm=webp" />
            <div class="absolute inset-0 bg-[#4f6073]/20 mix-blend-multiply"></div>
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2">
              <div class="w-12 h-12 bg-[#CD061F] rounded-full flex items-center justify-center text-white animate-pulse shadow-lg">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="mb-12 text-center">
        <span class="text-sm font-bold tracking-[0.2em] text-outline uppercase block mb-4">Relaterade tjänster</span>
        <h2 class="font-headline text-4xl font-bold text-on-surface mb-4">Jämför med våra andra tjänster</h2>
        <p class="text-on-surface-variant max-w-2xl mx-auto">
          Vi hjälper även kunder i Borås och Svenljunga med fler snickeritjänster som kompletterar {service.name.toLowerCase()}.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {relatedServices.map((relatedService) => (
          <a
            href={`/tjanster/${relatedService.slug}`}
            class="group rounded-2xl border border-outline-variant/10 bg-surface-container-lowest p-8 shadow-sm transition-all hover:border-secondary/30 hover:shadow-lg"
          >
            <h3 class="text-2xl font-bold text-on-surface transition-colors group-hover:text-secondary">{relatedService.name}</h3>
            <p class="mt-3 text-on-surface-variant leading-relaxed">{relatedService.heroSubtitle}</p>
            <div class="mt-6 flex items-center text-sm font-bold uppercase tracking-wider text-secondary">
              Läs om tjänsten
              <span class="material-symbols-outlined ml-1 text-base transition-transform group-hover:translate-x-1">arrow_forward</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaPanel
    eyebrow="Redo att planera nästa steg?"
    title="Kontakta oss idag för att prata om ditt projekt."
    body=""
    primaryHref="/kontakt"
    primaryLabel="Få en kostnadsfri offert"
    secondaryHref={`tel:${siteConfig.primaryPhone.replace(/\s+/g, "")}`}
    secondaryLabel={`Eller ring oss: ${siteConfig.primaryPhone}`}
  />
</BaseLayout>
